opam-version: "2.0"
synopsis: "Um jogo 2D feito em OCaml usando Raylib"
description:
  "Jogo arcade de estilingue 2D com simulador de inercia e fisica implementado usando raylib-ocaml."
maintainer: ["Kakurokan"]
authors: ["Kakurokan"]
license: "MIT"
homepage: "https://github.com/Kakurokan/meu_jogo"
bug-reports: "https://github.com/Kakurokan/meu_jogo/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.14" & >= "3.14"}
  "raylib" {>= "0.0.1"}
  "odoc"
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Kakurokan/meu_jogo.git"
